# Copier en « .env » (non versionné) à côté de compose.yaml. Aucun secret dans ce fichier exemple.

# --- Connexion à Snitch ---
# URL HTTPS de l'application Snitch (le worker refuse le HTTP).
SNITCH_API_URL=https://snitch.example.org
# Jeton affiché une seule fois à la création du worker dans l'interface Snitch.
SNITCH_WORKER_TOKEN=
# Autorité de certification personnalisée (chemin dans le conteneur), facultatif.
SNITCH_WORKER_CA_BUNDLE=
# Tâches simultanées (1 à 4). Garder 1 : 12 Go de VRAM partagés avec un éventuel Ollama.
SNITCH_WORKER_CAPACITY=1
# Niveau des logs JSON (docker logs) : ERROR, WARN, INFO (défaut) ou DEBUG.
LOG_LEVEL=INFO
# Nom facultatif de la machine hôte, sinon le nom du conteneur est utilisé.
SNITCH_WORKER_MACHINE_NAME=

# --- Transcription (serveur compatible POST /v1/audio/transcriptions) ---
# Whisper lancé sur le PC hors Docker : http://host.docker.internal:8000
# Whisper dans un conteneur du réseau partagé : http://nom-du-service:8000
TRANSCRIPTION_API_URL=http://host.docker.internal:8000
# Nom de modèle reconnu par ce serveur (obligatoire, aucun défaut).
TRANSCRIPTION_MODEL=
# Clé bearer facultative.
TRANSCRIPTION_API_KEY=

# --- Voix (pyannote) ---
# Dossier hôte des modèles : il contient « diarization » et « embedding » (voir le guide).
SNITCH_MODELS_DIR=/chemin/vers/snitch-models
SNITCH_VOICE_DIARIZATION_MODEL_PATH=/models/diarization
SNITCH_VOICE_EMBEDDING_MODEL_PATH=/models/embedding
# Révision du modèle d'empreinte. Laisser vide : les modèles s'installent depuis Snitch ;
# à renseigner seulement pour des modèles préparés à la main.
# Deux versions de modèle produisent des empreintes incomparables.
SNITCH_VOICE_EMBEDDING_MODEL_VERSION=
SNITCH_VOICE_EMBEDDING_MODEL_NAME=pyannote/wespeaker-voxceleb-resnet34-LM
# cuda (échoue sans GPU), auto ou cpu.
SNITCH_VOICE_DEVICE=cuda

# --- Modèles vocaux ---
# Un worker neuf n'a aucun modèle et n'en télécharge aucun : ils s'installent depuis Snitch
# (administration, Voix). Aucune variable de téléchargement ni jeton Hugging Face ici.

# --- Image ---
# Défaut : ghcr.io/thomas-bsn/snitch-worker:latest, tirée à chaque « docker compose up ».
# Épingler la version de Snitch déployée pour rester compatible avec l'application :
# SNITCH_WORKER_IMAGE=ghcr.io/thomas-bsn/snitch-worker:vX.Y.Z
# --- Réseau partagé (voir compose.yaml) ---
# SHARED_NETWORK=ollama_default
