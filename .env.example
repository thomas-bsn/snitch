# Copier en .env pour Docker Compose local ; ne jamais committer ce fichier.
# Développement local : image construite par compose.override.yaml.
# Déploiement (Forgeyard ou serveur) : supprimer cette ligne pour utiliser ghcr.io/thomas-bsn/snitch:latest,
# ou épingler une version (ghcr.io/thomas-bsn/snitch:vX.Y.Z ou @sha256:…).
SNITCH_IMAGE=snitch:local
# Facultatif : par défaut les copies publiées ghcr.io/thomas-bsn/snitch-postgres:latest et snitch-embed:latest
# (copies sans modification des images amont épinglées dans deploy/upstream-images.json).
# L'override local utilise directement les images amont épinglées.
# POSTGRES_IMAGE=
# EMBED_IMAGE=
POSTGRES_PASSWORD=replace-with-random-password
# openssl rand -base64 32 — sauvegarder séparément de la base.
MASTER_KEY=
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
DISPLAY_NAME=Snitch
# Image affichée dans le compose généré à la création d'un worker (vide : ghcr.io/thomas-bsn/snitch-worker-gpu:latest).
WORKER_IMAGE=
# Les chemins doivent être accessibles à l'application et montés en lecture seule.
# Forgeyard ne permet pas encore les montages hôte ; laisser vide si indisponible.
CLIPS_ROOTS=
FFPROBE_PATH=ffprobe
CLIP_STABILITY_WINDOW=3s
SOURCE_RECONCILE_INTERVAL=5m
CLIP_EXCLUDE_PATTERNS=.*,*.tmp,*.part,*.partial,*.crdownload,*.download
# Résumés d’upload privés dans un volume nommé séparé de PostgreSQL.
UPLOAD_ROOT=/data/media
MAX_UPLOAD_BYTES=21474836480
UPLOAD_CHUNK_BYTES=4194304
UPLOAD_SESSION_TTL=168h
EMBEDDINGS_URL=http://embed:11434/v1/embeddings
EMBEDDINGS_MODEL=
