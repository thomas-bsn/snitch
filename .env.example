# Copier en .env pour Docker Compose local ; ne jamais committer ce fichier.
RECEIPTS_IMAGE=snitch:local
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg18-bookworm@sha256:2358fcba361ed2233a5ed81b5fe4ca779ccb304120ce531a3bf51c0ed7e2bc11
EMBED_IMAGE=ollama/ollama:0.40.10@sha256:4c5b27871a3239a717048f9b93057680a51b60c8119a7016aebb57f938e25e35
POSTGRES_PASSWORD=replace-with-random-password
# openssl rand -base64 32 — sauvegarder séparément de la base.
MASTER_KEY=
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
DISPLAY_NAME=Receipts
# Liste réservée à phase 1, aucun scan en phase 0.
CLIPS_ROOTS=
EMBEDDINGS_URL=http://embed:11434/v1/embeddings
EMBEDDINGS_MODEL=
