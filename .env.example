# Copier en .env pour Docker Compose local ; ne jamais committer ce fichier.
# Développement local : image construite par compose.override.yaml.
# Déploiement (Forgeyard ou serveur) : supprimer cette ligne pour utiliser ghcr.io/thomas-bsn/snitch:latest,
# ou épingler une version (ghcr.io/thomas-bsn/snitch:vX.Y.Z ou @sha256:…).
SNITCH_IMAGE=snitch:local
# Facultatif : par défaut compose.yaml tire directement les images amont (Docker Hub) épinglées par digest
# (pgvector/pgvector et ollama/ollama, références de deploy/upstream-images.json). Ne les surcharger que pour en changer.
# POSTGRES_IMAGE=
# EMBED_IMAGE=
# Mot de passe de la base : facultatif. Laisser commenté : le déploiement le produit au premier démarrage, le conserve
# dans le volume « secrets » et ne l'affiche jamais. Ne le renseigner que pour une installation existante, dont la
# base porte déjà ce mot de passe ; il reste alors prioritaire.
# POSTGRES_PASSWORD=
# Clé maître : facultative. Laisser commenté : l'application la génère au premier démarrage et la conserve dans le
# volume « secrets », hors de la base et de ses sauvegardes. L'exporter depuis l'administration et la conserver
# séparément. Ne la renseigner (openssl rand -base64 32) que pour une installation existante, ou pour restaurer une
# clé exportée ; elle reste alors prioritaire et n'est jamais recopiée dans le volume.
# MASTER_KEY=
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
DISPLAY_NAME=Snitch
# Image affichée dans le compose généré à la création d'un worker (vide : ghcr.io/thomas-bsn/snitch-worker:latest).
WORKER_IMAGE=
# Les chemins doivent être accessibles à l'application et montés en lecture seule.
# Forgeyard ne permet pas encore les montages hôte ; laisser vide si indisponible.
CLIPS_ROOTS=
FFPROBE_PATH=ffprobe
CLIP_STABILITY_WINDOW=3s
SOURCE_RECONCILE_INTERVAL=5m
CLIP_EXCLUDE_PATTERNS=.*,*.tmp,*.part,*.partial,*.crdownload,*.download
# Résumés d’upload privés dans un volume nommé séparé de PostgreSQL.
UPLOAD_ROOT=/data/media
MAX_UPLOAD_BYTES=21474836480
UPLOAD_CHUNK_BYTES=4194304
UPLOAD_SESSION_TTL=168h
EMBEDDINGS_URL=http://embed:11434/v1/embeddings
EMBEDDINGS_MODEL=
