{
  "name": "snitch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "generate": "openapi-typescript ../contracts/openapi.yaml -o src/api.gen.ts && prettier --write src/api.gen.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e legacy public *.ts *.json index.html",
    "lint": "prettier --check src e2e legacy public *.ts *.json index.html"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.61.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
